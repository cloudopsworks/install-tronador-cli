{
  "name": "install-tronador-cli",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that installs the CloudOps Works Tronador CLI from verified GitHub Release artifacts.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "main": "src/main.mjs",
  "scripts": {
    "build": "ncc build src/main.mjs --out dist --license LICENSES.txt",
    "test": "node --test \"test/*.test.mjs\"",
    "all": "npm run build && npm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1"
  }
}
